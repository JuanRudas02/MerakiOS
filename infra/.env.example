# ─────────────────────────────────────────────────────────────────────────────
# 1heavy — variables para infra/docker-compose.yml
# Copiar a infra/.env (make env). NUNCA commitear valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (plataforma) ──
POSTGRES_USER=oneheavy
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=oneheavy

# ── MariaDB (Mautic) ──
MAUTIC_DB_ROOT_PASSWORD=change-me-mariadb-root
MAUTIC_DB_USER=mautic
MAUTIC_DB_PASSWORD=change-me-mautic-db
MAUTIC_DB_NAME=mautic

# ── Evolution API (WhatsApp) ──
EVOLUTION_API_KEY=change-me-evolution-key

# ── Frontend ──
VITE_API_URL=http://localhost:8000/api/v1

# ═════ API (prefijo ONEHEAVY_) — ver apps/api/src/oneheavy/shared/infrastructure/config.py ═════
ONEHEAVY_ENV=local
ONEHEAVY_APP_NAME=1heavy API
ONEHEAVY_PUBLIC_APP_URL=http://localhost:5173
ONEHEAVY_LOG_LEVEL=INFO
ONEHEAVY_LOG_JSON=true

# Base de datos (el host "db" es el servicio de compose)
ONEHEAVY_DATABASE_URL=postgresql+asyncpg://oneheavy:change-me-postgres@db:5432/oneheavy
ONEHEAVY_DB_ECHO=false
ONEHEAVY_DB_AUTO_CREATE=true

# Seguridad — generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ONEHEAVY_JWT_SECRET=change-me-generate-a-long-random-secret
ONEHEAVY_JWT_ALGORITHM=HS256
ONEHEAVY_JWT_TTL_MINUTES=720
ONEHEAVY_CORS_ORIGINS=["http://localhost:5173","http://localhost:8088"]
ONEHEAVY_LOGIN_RATE_LIMIT=5/minute

# Procesos batch
ONEHEAVY_SCHEDULER_ENABLED=true
ONEHEAVY_SCHEDULER_TIMEZONE=America/Bogota

# Archivos (fotos de evidencia, comprobantes)
ONEHEAVY_STORAGE_DIR=/app/storage
ONEHEAVY_MAX_UPLOAD_MB=10

# IA (fake | openai)
ONEHEAVY_LLM_PROVIDER=fake
ONEHEAVY_OPENAI_API_KEY=
ONEHEAVY_OPENAI_MODEL=gpt-4o-mini
ONEHEAVY_TAVILY_API_KEY=

# WhatsApp (console | evolution)
ONEHEAVY_MESSAGING_PROVIDER=console
ONEHEAVY_EVOLUTION_API_URL=http://evolution:8080
ONEHEAVY_EVOLUTION_API_KEY=change-me-evolution-key

# Mautic
ONEHEAVY_MAUTIC_ENABLED=false
ONEHEAVY_MAUTIC_BASE_URL=http://mautic
ONEHEAVY_MAUTIC_USERNAME=
ONEHEAVY_MAUTIC_PASSWORD=
ONEHEAVY_MAUTIC_WEBHOOK_SECRET=

# Meta Business
ONEHEAVY_META_ENABLED=false
ONEHEAVY_META_GRAPH_VERSION=v21.0
ONEHEAVY_META_APP_SECRET=
ONEHEAVY_META_VERIFY_TOKEN=
ONEHEAVY_META_SYSTEM_USER_TOKEN=

# Pagos (Wompi)
ONEHEAVY_WOMPI_PUBLIC_KEY=
ONEHEAVY_WOMPI_INTEGRITY_SECRET=
ONEHEAVY_WOMPI_EVENTS_SECRET=
