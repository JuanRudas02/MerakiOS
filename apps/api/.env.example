# 1heavy API — desarrollo local (make dev-api). Copiar a apps/api/.env
# Con `make up-deps` Postgres queda en localhost:5432.
ONEHEAVY_ENV=local
ONEHEAVY_PUBLIC_APP_URL=http://localhost:5173
ONEHEAVY_LOG_LEVEL=INFO
ONEHEAVY_LOG_JSON=false

ONEHEAVY_DATABASE_URL=postgresql+asyncpg://oneheavy:change-me-postgres@localhost:5432/oneheavy
# Alternativa sin Docker: ONEHEAVY_DATABASE_URL=sqlite+aiosqlite:///./oneheavy_local.db
ONEHEAVY_DB_AUTO_CREATE=true

ONEHEAVY_JWT_SECRET=change-me-generate-a-long-random-secret
ONEHEAVY_JWT_TTL_MINUTES=720
ONEHEAVY_CORS_ORIGINS=["http://localhost:5173"]
ONEHEAVY_LOGIN_RATE_LIMIT=5/minute

ONEHEAVY_SCHEDULER_ENABLED=true
ONEHEAVY_SCHEDULER_TIMEZONE=America/Bogota
ONEHEAVY_STORAGE_DIR=storage
ONEHEAVY_MAX_UPLOAD_MB=10

# Proveedor de IA: fake (sin costo, plantillas) | anthropic (recomendado) | openai
ONEHEAVY_LLM_PROVIDER=fake
# Clave de Anthropic (también se acepta ANTHROPIC_API_KEY). Nunca la subas al repositorio.
ONEHEAVY_ANTHROPIC_API_KEY=
ONEHEAVY_ANTHROPIC_MODEL=claude-opus-5-5
# Profundidad del razonamiento: low | medium | high | xhigh | max
ONEHEAVY_ANTHROPIC_EFFORT=medium
ONEHEAVY_OPENAI_API_KEY=
ONEHEAVY_OPENAI_MODEL=gpt-4o-mini
ONEHEAVY_TAVILY_API_KEY=

ONEHEAVY_MESSAGING_PROVIDER=console
ONEHEAVY_EVOLUTION_API_URL=http://localhost:8080
ONEHEAVY_EVOLUTION_API_KEY=

ONEHEAVY_MAUTIC_ENABLED=false
ONEHEAVY_MAUTIC_BASE_URL=http://localhost:8081
ONEHEAVY_MAUTIC_USERNAME=
ONEHEAVY_MAUTIC_PASSWORD=
ONEHEAVY_MAUTIC_WEBHOOK_SECRET=

ONEHEAVY_META_ENABLED=false
ONEHEAVY_META_GRAPH_VERSION=v21.0
ONEHEAVY_META_APP_SECRET=
ONEHEAVY_META_VERIFY_TOKEN=
ONEHEAVY_META_SYSTEM_USER_TOKEN=

ONEHEAVY_WOMPI_PUBLIC_KEY=
ONEHEAVY_WOMPI_INTEGRITY_SECRET=
ONEHEAVY_WOMPI_EVENTS_SECRET=
